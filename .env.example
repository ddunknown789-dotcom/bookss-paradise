# ---------------------------------------------------------------------------
# Supabase
#
# Get these from: Supabase dashboard → your project → Settings → API
# Copy this file to `.env.local` and fill in the three values.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key — safe in the browser, RLS applies to it
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — BYPASSES RLS. Server-side only. Never commit it,
# never expose it to the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref (the subdomain of the URL above). Used by `npm run db:types`.
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, used for sitemap/robots/canonical URLs when the
# `site.url` setting is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:5180
